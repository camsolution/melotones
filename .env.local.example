# Supabase — projet Postgres + Auth + Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL canonique du site (utilisée pour les webhooks, callbacks de paiement, liens d'emails)
NEXT_PUBLIC_SITE_URL=https://melotones.co

# Mode démo : simule la génération musicale au lieu d'appeler MusicGPT — à laisser sur false/absent en production.
NEXT_PUBLIC_MOCK_AI=false

# MusicGPT — génération musicale (aucune API de solde/langue exposée par leur service)
MUSICGPT_API_KEY=
# Jeton secret vérifié sur le webhook MusicGPT (protège contre les appels forgés).
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MUSICGPT_WEBHOOK_SECRET=

# Google Gemini — chatbot support + suggestions de paroles
GEMINI_API_KEY=

# PayDunya — paiement Mobile Money / carte (Sénégal). Les 4 clés sont requises sur
# chaque appel API. PAYDUNYA_MODE=live pour la production, toute autre valeur (ou
# absent) bascule sur le sandbox.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=

# CinetPay — bâti mais non branché dans le flux de paiement actif (lib/payments/cinetpay.ts)
CINETPAY_APIKEY=
CINETPAY_SITE_ID=

# Resend — emails transactionnels et campagnes marketing
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Numéro WhatsApp affiché pour le support (optionnel)
MELOTONES_SUPPORT_WHATSAPP=

# Vérification humaine (CAPTCHA Cloudflare Turnstile) sur /login et /signup — optionnel.
# Laisser vide désactive complètement le widget, sans casser la connexion.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secrets dédiés aux routines cloud (agents d'automatisation) — jamais
# SUPABASE_SERVICE_ROLE_KEY, pour limiter le blast radius en cas de fuite.
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_EXPORT_SECRET=
AUTOMATION_SECRET=
